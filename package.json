{
  "name": "wa11y-ai",
  "version": "0.1.0",
  "description": "Accessible design tokens and typed tools for React and other web applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./styles/tokens.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./ai.md": "./docs/ai.md",
    "./components.css": "./styles/components.css",
    "./icons.css": "./styles/icon.css"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "styles/tokens.css",
    "docs/ai.md",
    "llms.txt",
    "README.md",
    "LICENSE",
    "styles/button.css",
    "assets/button/*.svg",
    "styles/components.css",
    "styles/input.css",
    "assets/input/*.svg",
    "styles/dropdown.css",
    "styles/checkbox.css",
    "assets/checkbox/*.svg",
    "styles/radio.css",
    "assets/radio/*.svg",
    "styles/switch.css",
    "assets/switch/*.svg",
    "styles/icon.css",
    "styles/badge.css",
    "styles/alert.css",
    "styles/avatar.css",
    "assets/avatar/*.png",
    "styles/avatar-listing.css",
    "styles/card.css",
    "styles/progress-bar.css",
    "styles/card-horizontal.css",
    "styles/data-table.css",
    "styles/sidebar.css",
    "styles/breadcrumbs.css",
    "styles/skip-content.css",
    "styles/tooltip.css",
    "assets/tooltip/*.svg",
    "styles/menu-float-mobile.css",
    "styles/main-menu-item.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "accessibility",
    "design-system",
    "design-tokens",
    "react",
    "typescript",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tests/tsconfig.json",
    "test": "npm run build:check && node --test tests/*.test.mjs && npm run typecheck",
    "validate": "npm test && npm run package:check",
    "package:check": "node scripts/check-package.mjs",
    "playground": "npm run build && node scripts/build-playground.mjs && node scripts/playground.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run validate",
    "playground:check": "node --check playground/playground.js && node scripts/build-playground.mjs && node scripts/playground.mjs --check",
    "accessibility:check": "node scripts/check-accessibility.mjs"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "dependencies": {
    "material-symbols": "^0.49.0"
  }
}
